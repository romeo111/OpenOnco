# Copy to .env for local server-only testing. Never commit real keys.
OPENAI_API_KEY=sk-proj-replace-with-openonco-project-key
OPENAI_MODEL=gpt-5.2
# One explicit browser origin; wildcard origins are rejected by the endpoint.
OPENONCO_ALLOWED_ORIGIN=https://openonco.info
# Set only when the deployment's proxy removes client-supplied forwarding headers.
# OPENONCO_TRUST_PROXY_HEADERS=1
# Optional metadata-only operational log. Never point this at a shared public path.
# OPENONCO_ASK_AUDIT_LOG=/secure/path/openonco-ask.jsonl
# OPENONCO_DEBUG=1
